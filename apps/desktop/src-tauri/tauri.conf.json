{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NEXCHAT",
  "version": "0.1.0",
  "identifier": "com.nexchat.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @nexchat/web dev -- --host 0.0.0.0",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @nexchat/web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "NEXCHAT",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src ipc: http://ipc.localhost http://localhost:4000 ws://localhost:4000 https: wss:; img-src 'self' asset: http://asset.localhost https: data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
